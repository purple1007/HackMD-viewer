{
  "compilerOptions": {
    "jsx": "react",
    "jsxFactory": "figma.widget.h",
    "jsxFragmentFactory": "figma.widget.Fragment",
    "module": "ES2015",
    "moduleResolution": "node",
    "target": "es6",
    "lib": [
      "es2017"
    ],
    "strict": true,
    "typeRoots": [
      "../node_modules/@figma"
    ],
    "esModuleInterop": true,
    "skipLibCheck": true
  },
  "include": [
    "."
  ]
}
